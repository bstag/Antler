---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSiteConfig } from '../lib/config/static';

const config = await getSiteConfig();
const siteName = config.customization?.siteName || 'Antler';
const authorEmail = config.customization?.author?.email || 'privacy@example.com';
---

<BaseLayout title={`Privacy Policy - ${siteName}`} description={`Privacy Policy and data practices for ${siteName}.`}>
  <Header />
  <main class="min-h-screen bg-surface py-16">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="mb-12">
        <h1 class="text-4xl md:text-5xl font-bold text-slate-900 dark:text-white mb-4">
          Privacy Policy
        </h1>
        <p class="text-slate-600 dark:text-slate-400">
          Last updated: {new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        </p>
      </div>

      <div class="prose dark:prose-invert max-w-none space-y-6 text-slate-700 dark:text-slate-300">
        <section>
          <h2 class="text-2xl font-semibold text-slate-900 dark:text-white mb-3">1. Overview</h2>
          <p>
            Welcome to {siteName}. We respect your privacy and are committed to protecting any information you share with us through our website.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-semibold text-slate-900 dark:text-white mb-3">2. Information Collection</h2>
          <p>
            This website is statically generated and prioritizes privacy. We only collect information that you voluntarily provide when submitting our contact form (such as your name and email address).
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-semibold text-slate-900 dark:text-white mb-3">3. How We Use Information</h2>
          <p>
            Information submitted via the contact form is used solely to respond to your inquiries and project requests. We do not sell or rent your personal information to third parties.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-semibold text-slate-900 dark:text-white mb-3">4. Contact Us</h2>
          <p>
            If you have any questions about this Privacy Policy, please reach out to us at <a href={`mailto:${authorEmail}`} class="text-primary hover:underline">{authorEmail}</a>.
          </p>
        </section>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
