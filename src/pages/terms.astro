---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSiteConfig } from '../lib/config/static';

const config = await getSiteConfig();
const siteName = config.customization?.siteName || 'Antler';
const authorEmail = config.customization?.author?.email || 'terms@example.com';
---

<BaseLayout title={`Terms of Service - ${siteName}`} description={`Terms of Service for using ${siteName}.`}>
  <Header />
  <main class="min-h-screen bg-surface py-16">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="mb-12">
        <h1 class="text-4xl md:text-5xl font-bold text-slate-900 dark:text-white mb-4">
          Terms of Service
        </h1>
        <p class="text-slate-600 dark:text-slate-400">
          Last updated: {new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        </p>
      </div>

      <div class="prose dark:prose-invert max-w-none space-y-6 text-slate-700 dark:text-slate-300">
        <section>
          <h2 class="text-2xl font-semibold text-slate-900 dark:text-white mb-3">1. Agreement to Terms</h2>
          <p>
            By accessing or using {siteName}, you agree to be bound by these Terms of Service. If you disagree with any part of these terms, please do not use our site.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-semibold text-slate-900 dark:text-white mb-3">2. Intellectual Property</h2>
          <p>
            The content, design, code, and graphics on this website are the property of {siteName} unless otherwise indicated and are protected by applicable copyright and intellectual property laws.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-semibold text-slate-900 dark:text-white mb-3">3. Disclaimer</h2>
          <p>
            The materials on this website are provided on an 'as is' basis without warranties of any kind, either express or implied.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-semibold text-slate-900 dark:text-white mb-3">4. Contact Information</h2>
          <p>
            For questions regarding these Terms of Service, please contact <a href={`mailto:${authorEmail}`} class="text-primary hover:underline">{authorEmail}</a>.
          </p>
        </section>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
